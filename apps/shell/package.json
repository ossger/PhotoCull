{
  "name": "@photocull/shell",
  "version": "0.3.0",
  "private": true,
  "description": "Electron + React shell for PhotoCull",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsc -p tsconfig.main.json",
    "preview": "vite preview",
    "lint": "eslint src --max-warnings=0",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^1.8.10",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.10",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "electronVersion": "30.5.1",
    "appId": "com.photocull.app",
    "productName": "PhotoCull",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "extraResources": [
      {
        "from": "../worker/dist-bin/photocull-worker",
        "to": "worker",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.photography",
      "artifactName": "${productName}-${version}-macOS-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false,
      "entitlements": "../../packaging/entitlements.mac.plist",
      "entitlementsInherit": "../../packaging/entitlements.mac.inherit.plist"
    },
    "afterPack": "../../packaging/sign-worker.js",
    "afterSign": "../../packaging/notarize.js",
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-${version}-Windows-${arch}.${ext}"
    }
  }
}
